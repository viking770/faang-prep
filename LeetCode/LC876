public class LinkedList{
    private int size;
    private Node head;
    private Node tail;

    class Node{
       int data;
       Node next;

       public Node(int data){
        this.data = data;
        this.next = null;
       }
    }

    public LinkedList(int data){
        Node node = new Node(data);
        this.head = node;
        this.tail = node;
        size = 1;
    }

    public Node findMiddleNode(){
        if(head==null) return null;
        Node slow = head;
        Node fast = head.next.next;
        while(fast!=null && fast.next!=null){
            slow = slow.next;
            fast = fast.next.next;
        }
        return slow;
    }
}